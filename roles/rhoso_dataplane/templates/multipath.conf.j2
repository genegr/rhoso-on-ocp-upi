# Managed by rhoso-on-ocp-upi (edpm_multipathd custom config). Everpure/Pure Storage FlashArray iSCSI settings, the
# same device section as the OCP nodes (OCP repo roles/storage_node/files/multipath.conf).
# edpm_multipathd then sets find_multipaths / recheck_wwid / skip_kpartx / user_friendly_names in defaults.
defaults {
	user_friendly_names no
	find_multipaths yes
	recheck_wwid yes
	skip_kpartx yes
	polling_interval 10
}

devices {
	device {
		vendor                "PURE"
		product               "FlashArray"
		path_selector         "service-time 0"
		hardware_handler      "1 alua"
		path_grouping_policy  group_by_prio
		prio                  alua
		failback              immediate
		path_checker          tur
		fast_io_fail_tmo      10
		user_friendly_names   no
		no_path_retry         0
		features              0
		dev_loss_tmo          600
	}
}

blacklist {
}
